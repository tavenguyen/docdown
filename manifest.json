{
  "manifest_version": 3,

  "name": "DocDown",
  "version": "1.0.0",
  "description": "Chrome extension that rebuilds Studocu documents into print-ready PDFs from the pages the site already sends.",
  "author": "DocDown",
  "icons": {
    "128": "img/icon.png"
  },

  "permissions": ["cookies", "browsingData"],

  "host_permissions": [
    "https://*.studocu.com/*",
    "https://*.studocu.vn/*",
    "https://*.studocu.id/*",
    "https://*.studeersnel.nl/*",
    "https://*.tailieu.vn/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["print.html"],
      "matches": [
        "https://*.studocu.com/*",
        "https://*.studocu.vn/*",
        "https://*.studocu.id/*",
        "https://*.studeersnel.nl/*",
        "https://tailieu.vn/doc/*"
      ]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "https://*.studocu.com/*",
        "https://*.studocu.vn/*",
        "https://*.studocu.id/*",
        "https://*.studeersnel.nl/*",
        "https://tailieu.vn/doc/*"
      ],
      "js": [
        "lib/core.js",
        "lib/sanitize.js",
        "lib/render.js",
        "lib/registry.js",
        "providers/studocu.js",
        "providers/tailieu.js",
        "content/ui.js",
        "content/main.js"
      ],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
